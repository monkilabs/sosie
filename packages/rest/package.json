{
  "name": "@sosie/rest",
  "version": "0.1.0",
  "description": "The REST source of Sosie: a local HTTP endpoint in front of your API that fakes every value.",
  "keywords": [
    "rest",
    "openapi",
    "ai",
    "llm",
    "privacy",
    "fake-data",
    "anonymization"
  ],
  "homepage": "https://monkilabs.github.io/sosie/",
  "bugs": {
    "url": "https://github.com/monkilabs/sosie/issues"
  },
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/monkilabs/sosie.git",
    "directory": "packages/rest"
  },
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@sosie/core": "^0.1.0",
    "yaml": "^2.9.1"
  }
}
