// The test database, as a team using Prisma would describe it. Generated by test/e2e/database.ts.
generator client {
  provider     = "prisma-client"
  output       = "./generated"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum role {
  admin
  editor
  viewer
}

enum order_status {
  new
  paid
  shipped
  cancelled
}

model User {
  id        Int      @id @default(autoincrement())
  email     String?  @unique @db.VarChar(120)
  fullName  String   @map("full_name")
  role      role
  active    Boolean
  createdAt DateTime @map("created_at") @db.Timestamptz
  profile   Json?
  orders    Order[]

  @@map("users")
}

model Order {
  id       BigInt       @id @default(autoincrement())
  userId   Int          @map("user_id")
  status   order_status
  total    Decimal      @db.Decimal(10, 2)
  placedAt DateTime     @map("placed_at") @db.Timestamp
  user     User         @relation(fields: [userId], references: [id])

  @@map("orders")
}
